{
  "name": "@mukae/relay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && printf '%s\\n' '*.test.js' '*.test.js.map' '*.test.d.ts' '*.test.d.ts.map' '*.tsbuildinfo' > dist/.npmignore",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "tsc -p tsconfig.json && node --test dist/*.test.js"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "^1.6.0",
    "@hono/node-server": "^1.19.9",
    "@hono/node-ws": "^1.3.0",
    "@mukae/contract": "workspace:*",
    "better-auth": "^1.6.0",
    "better-sqlite3": "^12.6.2",
    "hono": "^4.10.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.6.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.2",
    "ws": "^8.18.3"
  }
}
