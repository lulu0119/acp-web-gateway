    "@guiiai/logg": "^1.2.12",
    "@hono/node-server": "^1.19.9",
    "@hono/node-ws": "^1.3.0",
    "@mukae/contract": "workspace:*",
    "better-auth": "^1.6.0",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "hono": "^4.10.7",
    "lucide-react": "^1.55.0",
