{
  "name": "@mukae/relay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc --noEmit -p web/tsconfig.json && vite build --config web/vite.config.ts && printf '%s\\n' '*.test.js' '*.test.js.map' '*.test.d.ts' '*.test.d.ts.map' '*.tsbuildinfo' > dist/.npmignore",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "tsc -p tsconfig.json && node --test dist/*.test.js",
    "web": "vite --config web/vite.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/oauth-provider": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/node-server": "^1.19.9",
    "@hono/node-ws": "^1.3.0",
    "@mukae/contract": "workspace:*",
    "@mukae/react-hooks": "workspace:*",
    "better-auth": "^1.6.0",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "hono": "^4.10.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.9",
    "ws": "^8.18.3"
  }
}
