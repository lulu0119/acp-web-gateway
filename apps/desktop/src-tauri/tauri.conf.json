{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Exterior",
  "version": "0.1.0",
  "identifier": "win.superpowerlulu.exterior",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:47103",
    "beforeDevCommand": "pnpm vite",
    "beforeBuildCommand": "pnpm --filter @exterior/desktop... build"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https://cdn.agentclientprotocol.com; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "appimage"],
    "externalBin": ["binaries/exterior"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.icns"],
    "macOS": { "signingIdentity": "-", "entitlements": "./entitlements.plist" },
    "windows": { "nsis": { "installMode": "currentUser" } },
    "linux": { "deb": { "depends": ["libayatana-appindicator3-1"] } }
  }
}
