{
  "name": "mukae",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "build": "pnpm -r --filter '!mukae' --if-present run build",
    "test": "pnpm -r --filter '!mukae' --if-present run test",
    "example": "pnpm --filter @mukae/example start",
    "explain": "pnpm --filter @mukae/explain dev"
  }
}
