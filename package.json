{
  "name": "exterior-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  },
  "scripts": {
    "build": "pnpm -r --filter \"!exterior-workspace\" --if-present run build",
    "test": "pnpm -r --filter \"!exterior-workspace\" --if-present run test",
    "example": "pnpm --filter @exterior/example start",
    "relay": "pnpm --filter @exterior/relay build && pnpm --filter @exterior/relay start"
  },
  "devDependencies": {
    "pkg-pr-new": "^0.0.91"
  }
}
