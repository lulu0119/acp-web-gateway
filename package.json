{
  "name": "mukae-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  },
  "scripts": {
    "build": "pnpm -r --filter '!mukae-workspace' --if-present run build",
    "test": "pnpm -r --filter '!mukae-workspace' --if-present run test",
    "example": "pnpm --filter @mukae/example start",
    "relay": "pnpm --filter @mukae/relay build && pnpm --filter @mukae/relay start"
  },
  "devDependencies": {
    "pkg-pr-new": "^0.0.91"
  }
}
