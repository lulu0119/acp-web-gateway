{
  "name": "@mukae/client",
  "version": "0.1.0-beta.1",
  "description": "Browser helper that opens the local mukae gateway from a click.",
  "type": "module",
  "files": ["dist"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lulu0119/mukae.git",
    "directory": "packages/client"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && printf '%s\n' '*.test.js' '*.test.js.map' '*.test.d.ts' '*.test.d.ts.map' '*.tsbuildinfo' > dist/.npmignore",
    "prepublishOnly": "pnpm run build",
    "test": "tsc -p tsconfig.json && node --test dist/choose-connect-action.test.js dist/connect.test.js dist/pick-port.test.js"
  },
  "dependencies": {
    "@mukae/contract": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.9.2"
  }
}
