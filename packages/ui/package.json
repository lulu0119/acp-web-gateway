{
  "name": "@exterior/ui",
  "private": true,
  "version": "0.0.0",
  "description": "Exterior's shared React controls, branding, and theme.",
  "type": "module",
  "exports": {
    "./styles.css": "./src/styles.css",
    "./utils": {
      "types": "./dist/utils.d.ts",
      "development": "./src/utils.ts",
      "default": "./dist/utils.js"
    },
    "./use-mobile": {
      "types": "./dist/use-mobile.d.ts",
      "development": "./src/use-mobile.ts",
      "default": "./dist/use-mobile.js"
    },
    "./props": {
      "types": "./dist/props.d.ts",
      "development": "./src/props.ts",
      "default": "./dist/props.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "development": "./src/*.tsx",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json --noEmit && node --test src/sidebar-width.test.ts",
    "palette": "node scripts/palette.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@exterior/contract": "workspace:*",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/quicksand": "^5.3.0",
    "@fontsource/maple-mono": "^5.3.0",
    "@iconify-json/mingcute": "^1.2.8",
    "@iconify/tailwind4": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.55.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@proj-airi/chromatic": "^1.1.5",
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.2"
  }
}
