{
  "name": "@exterior/ui",
  "private": true,
  "version": "0.0.0",
  "description": "Exterior's React components and theme, shared by the relay's pages and the desktop app.",
  "type": "module",
  "exports": {
    "./styles.css": "./src/styles.css",
    "./props": {
      "types": "./dist/props.d.ts",
      "development": "./src/props.ts",
      "default": "./dist/props.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "development": "./src/*.tsx",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json --noEmit",
    "palette": "node scripts/palette.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource/maple-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.55.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@proj-airi/chromatic": "^1.1.5",
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.2"
  }
}
