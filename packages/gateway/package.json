{
  "name": "exterior",
  "version": "0.1.0-beta.1",
  "description": "Daemon that runs ACP agents for an Exterior account.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lulu0119/exterior.git",
    "directory": "packages/gateway"
  },
  "bin": {
    "exterior": "./dist/bin/exterior.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "test": "tsc -p tsconfig.json --noEmit && vitest run",
    "build:executable": "pnpm run build && node scripts/build-executable.mjs"
  },
  "devDependencies": {
    "@exterior/contract": "workspace:*",
    "@exterioragentprotocol/sdk": "workspace:*",
    "@types/node": "^24.6.0",
    "@types/ws": "^8.18.1",
    "cac": "^7.1.0",
    "tsdown": "^0.23.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7",
    "ws": "^8.18.3"
  }
}
