{
  "name": "mukae",
  "version": "0.1.0-beta.1",
  "description": "Daemon that runs ACP agents for a Mukae account.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lulu0119/mukae.git",
    "directory": "packages/gateway"
  },
  "bin": {
    "mukae": "./dist/bin/mukae.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && printf '%s\n' '*.test.js' '*.test.js.map' '*.test.d.ts' '*.test.d.ts.map' '*.tsbuildinfo' > dist/.npmignore",
    "prepublishOnly": "pnpm run build",
    "test": "tsc -p tsconfig.json --noEmit && vitest run"
  },
  "dependencies": {
    "@mukae/client": "workspace:*",
    "@mukae/contract": "workspace:*",
    "cac": "^7.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  }
}
