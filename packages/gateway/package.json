{
  "name": "mukae",
  "version": "0.1.0-beta.1",
  "description": "Local gateway that lets a web page use an ACP agent on this computer.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lulu0119/mukae.git",
    "directory": "packages/gateway"
  },
  "bin": {
    "mukae": "./dist/cli.js"
  },
  "files": ["dist", "launcher/mukae-launcher"],
  "scripts": {
    "build": "tsc -p tsconfig.json && printf '%s\n' '*.test.js' '*.test.js.map' '*.test.d.ts' '*.test.d.ts.map' '*.tsbuildinfo' > dist/.npmignore",
    "prepublishOnly": "pnpm run build",
    "launcher": "clang -arch arm64 -arch x86_64 -fobjc-arc -framework Cocoa -o launcher/mukae-launcher launcher/launcher.m",
    "test": "tsc -p tsconfig.json && node --test dist/*.test.js"
  },
  "dependencies": {
    "@mukae/contract": "workspace:*",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.2"
  }
}
