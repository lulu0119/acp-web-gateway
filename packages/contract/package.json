{
  "name": "@mukae/contract",
  "version": "0.1.0-beta.1",
  "description": "Shared relay paths, agent types, and daemon messages for mukae.",
  "type": "module",
  "files": ["dist"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lulu0119/mukae.git",
    "directory": "packages/contract"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && printf '%s\n' '*.test.js' '*.test.js.map' '*.test.d.ts' '*.test.d.ts.map' '*.tsbuildinfo' > dist/.npmignore",
    "prepublishOnly": "pnpm run build",
    "test": "tsc -p tsconfig.json --noEmit && vitest run"
  },
  "dependencies": {
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  }
}
